# Streamlit Secrets Example
# Copy this file to .streamlit/secrets.toml locally or use Streamlit Cloud's secrets manager UI
# DO NOT commit .streamlit/secrets.toml to version control

LLM_API_KEY = "your-api-key-here"
LLM_BASE_URL = "https://your-openai-compatible-endpoint.example/v1"
LLM_MODEL = "your-model-name"

# Optional tuning parameters
LLM_REQUEST_TIMEOUT = 120
LLM_TEMPERATURE = 0.7
SIMULATION_MAX_AGENTS = 1000
SIMULATION_MAX_STEPS = 500
